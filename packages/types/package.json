{
  "name": "@kando/types",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./dist/validation/index.js",
      "default": "./dist/validation/index.js"
    },
    "./openapi": {
      "types": "./src/openapi/index.ts",
      "import": "./dist/openapi/index.js",
      "default": "./dist/openapi/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "typescript": "^6.0.2"
  }
}
