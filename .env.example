# =============================================================================
# Kando 環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   # 値を必要に応じて編集してから、次のいずれかで利用する
#
# Docker Compose:
#   docker compose up --build
#   # Compose はルートの .env を自動読み込みする
#
# ローカル開発（backend / frontend を個別起動）:
#   set -a && source .env && set +a          # bash / zsh
#   grep '^VITE_' .env > frontend/.env       # Vite は frontend/.env を参照する
#
# 本番では AUTH_SECRET・DB パスワードは必ず強固な値に変更すること
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose / PostgreSQL（compose.yaml, db-backup.sh 等）
# -----------------------------------------------------------------------------
POSTGRES_USER=kando_user
POSTGRES_PASSWORD=kando_password
POSTGRES_DB=kanban_db

# -----------------------------------------------------------------------------
# バックエンド API（backend/server.ts, backend/routes/auth.ts）
# -----------------------------------------------------------------------------
# ローカル開発: localhost の PostgreSQL を指す
# Docker Compose 内: compose.yaml が db ホスト名で上書きする
DATABASE_URL=postgres://kando_user:kando_password@localhost:5432/kanban_db

# JWT 署名シークレット（本番では openssl rand -hex 32 等で生成）
AUTH_SECRET=dev-only-secret-change-in-production

# API 待ち受けポート（既定: 3001）
PORT=3001

# 実行環境（production では CORS_ORIGIN と、開発用プレースホルダ以外の AUTH_SECRET が必須）
NODE_ENV=development

# 認証 Cookie の Secure 属性（未指定時は production だけ true）
# Compose の公開ポートは平文 HTTP のため、compose.yaml は false を渡す
# COOKIE_SECURE=false

# 信頼するリバースプロキシの段数（既定: 1 = nginx のみ）
# レートリミットのクライアント IP 判定に使う。nginx の前段に TLS 用プロキシ等を置いたら 2 にする
# 実際の段数より小さいと全ユーザーがプロキシ 1 つの IP にまとまり、1 人の失敗で全員がロックされる
# TRUST_PROXY=1

# CORS 許可オリジン（カンマ区切りで複数指定可）
# ローカル開発の既定: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Graceful shutdown のタイムアウト（ミリ秒、既定: 30000）
# SHUTDOWN_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# フロントエンド（Vite — frontend/.env にコピーして使用）
# -----------------------------------------------------------------------------
# バックエンド API のベース URL（開発時は Vite プロキシ経由で /api が既定）
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# E2E テスト（Playwright — 通常は手動設定不要）
# -----------------------------------------------------------------------------
# Playwright のベース URL（既定: http://localhost:5173）
# PLAYWRIGHT_BASE_URL=http://localhost:5173

# E2E 実行時に認証レートリミットを無効化（scripts/linux/e2e-server.sh が設定）
# E2E_TEST=true

# CI 環境では Playwright / GitHub Actions が自動設定（手動設定不要）
# CI=true
