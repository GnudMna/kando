{
  "name": "kando-backend",
  "version": "0.5.1",
  "description": "Kando API",
  "license": "MIT",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx migrate.ts",
    "migrate:create": "node-pg-migrate create -m migrations -j sql --migration-filename-format utc --template-file-name ../node_modules/node-pg-migrate/templates/migration-template.sql",
    "migrate:down": "node-pg-migrate down -m migrations -j sql",
    "build": "npm run build --workspace @kando/types && tsc && npm run openapi:generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "dev": "npm run build --workspace @kando/types && npm run openapi:generate && tsx watch server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @kando/types",
    "test": "vitest run",
    "test:router": "vitest run --config vitest.router.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kando/types": "file:../packages/types",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
